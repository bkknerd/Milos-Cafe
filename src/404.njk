{% raw_include "fonts.css" %}
body{margin:0;min-height:100vh;display:grid;place-items:center;background:#f8f7f3;color:#13234a;font:400 17px/1.6 'Instrument Sans',system-ui,sans-serif;padding:0 20px;text-align:center}
img{height:auto;width:min(320px,80vw);margin-bottom:36px}

---
permalink: /index.html
---
{%- set s = settings -%}
{%- set fullAddr = s.street + ", " + s.city + ", " + s.state + " " + s.zip -%}
{%- set siteUrl = s.site_url or build.url -%}
{%- set gDir = "https://www.google.com/maps/dir/?api=1&destination=" + ((s.business_name + " " + fullAddr) | enc) -%}
{%- set on = { kitchen: kitchen.enabled, menu: menu.enabled, reviews: reviews.enabled, gallery: gallery.enabled, faq: faq.enabled, patio: patio.enabled, visit: true } -%}
{%- macro ext(url) -%}{% if url and (url == s.order_url or url.startsWith('http')) %} target="_blank" rel="noopener"{% endif %}{%- endmacro -%}
{%- macro extmark(url) -%}{% if url and (url == s.order_url or url.startsWith('http')) %}<svg class="ext" viewBox="0 0 12 12" aria-hidden="true"><path d="M4 2h6v6M10 2L3 9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="sr">{% if url == s.order_url %} (opens {{ s.order_provider or "online ordering" }} in a new tab){% else %} (opens in a new tab){% endif %}</span>{% endif %}{%- endmacro -%}
{%- macro ink(v) -%}{% set p = ["M4 12C62 6 128 15 196 9S276 9 296 5|M18 15C86 11 160 17 226 12S278 11 288 9","M3 9C70 15 140 6 210 11S270 13 297 8|M22 13C92 17 168 9 232 13S280 14 290 12","M5 13C58 8 120 11 180 8S262 6 296 10|M16 16C80 12 150 15 212 11S272 10 288 13"][v % 3].split("|") %}<svg class="ink" viewBox="0 0 300 20" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path pathLength="1" d="{{ p[0] }}"/><path class="ink2" pathLength="1" d="{{ p[1] }}"/></svg>{%- endmacro -%}
{%- macro heading(d) -%}{{ d.heading }}{% if d.heading_italic %} <i>{{ d.heading_italic }}</i>{% endif %}{%- endmacro -%}
<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"/>
<script>document.documentElement.classList.add("js")</script>
<meta content="width=device-width, initial-scale=1, viewport-fit=cover" name="viewport"/>
<title>{{ s.seo_title }}</title>
<meta name="description" content="{{ s.seo_description }}"/>
<meta name="theme-color" content="#f8f7f3"/>
<link rel="preload" href="/fonts/fraunces-normal.woff2" as="font" type="font/woff2" crossorigin/>
<link rel="preload" href="/fonts/instrument-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin/>
<link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
<link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
{% if siteUrl %}<link rel="canonical" href="{{ siteUrl }}/"/>{% endif %}
<meta property="og:type" content="website"/>
{% if siteUrl %}<meta property="og:url" content="{{ siteUrl }}/"/>{% endif %}
<meta property="og:locale" content="en_US"/>
<meta name="geo.region" content="US-{{ s.state }}"/>
<meta name="geo.placename" content="{{ s.city }}"/>
<meta name="geo.position" content="{{ s.latitude }};{{ s.longitude }}"/>
<meta property="og:site_name" content="{{ s.business_name }}"/>
<meta property="og:title" content="{{ s.share_title }}"/>
<meta property="og:description" content="{{ s.share_description }}"/>
<meta property="og:image" content="{{ siteUrl if s.share_image.startsWith('/') }}{{ s.share_image }}"/>
<meta name="twitter:card" content="summary_large_image"/>
<script type="application/ld+json">{{ {
  "@context": "https://schema.org", "@type": "CafeOrCoffeeShop", "@id": siteUrl + "/#cafe", "name": s.business_name,
  "logo": (siteUrl if s.logo.startsWith('/')) + s.logo,
  "url": siteUrl, "image": (siteUrl if s.share_image.startsWith('/')) + s.share_image,
  "telephone": s.phone_dial, "servesCuisine": s.cuisine,
  "address": { "@type": "PostalAddress", "streetAddress": s.street, "addressLocality": s.city, "addressRegion": s.state, "postalCode": s.zip, "addressCountry": "US" },
  "geo": { "@type": "GeoCoordinates", "latitude": s.latitude, "longitude": s.longitude },
  "openingHoursSpecification": hours.days | hoursSchema,
  "sameAs": [s.instagram_url, s.yelp_url],
  "description": s.seo_description,
  "areaServed": s.area_served | areaServed(s.state),
  "award": (kitchen.award_title + ", " + kitchen.award_subtitle) if kitchen.award_show else undefined,
  "hasMenu": menu | menuSchema(siteUrl), "acceptsReservations": false,
  "potentialAction": { "@type": "OrderAction", "target": { "@type": "EntryPoint", "urlTemplate": s.order_url, "actionPlatform": ["https://schema.org/DesktopWebPlatform", "https://schema.org/MobileWebPlatform"] }, "deliveryMethod": ["http://purl.org/goodrelations/v1#DeliveryModePickUp", "http://purl.org/goodrelations/v1#DeliveryModeOwnFleet"] }
} | json | safe }}</script>
{% if faq.enabled and faq.items.length %}<script type="application/ld+json">{{ {
  "@context": "https://schema.org", "@type": "FAQPage",
  "mainEntity": faq.items | faqSchema(hours)
} | json | safe }}</script>{% endif %}
<style>{% raw_include "fonts.css" %}{% raw_include "styles.css" %}</style>
<script>/* Netlify Identity invite / password links land here: send them to the CMS */
if(/(invite|recovery|confirmation|email_change)_token=/.test(location.hash))location.replace("/admin/"+location.hash);</script>
</head><body>
{% include "ink-defs.njk" %}
<a class="skip" href="#main">Skip to content</a>
<header class="hd"><div class="w hd-in">
<a aria-label="{{ s.business_name }}, back to top" class="logo" href="#"><img alt="{{ s.business_name }} logo" src="{{ s.logo }}" width="900" height="216"/></a>
<nav class="nav" aria-label="Sections">{% for n in header.nav %}{% if on[n.target] %}<a href="#{{ n.target }}">{{ n.label }}</a>{% endif %}{% endfor %}</nav>
<div class="hd-r"><a class="today" href="#visit" data-label="{{ header.topbar_today_label }}"></a>{% if on.menu %}<a class="m-menu" href="#menu">{{ header.mobile_menu_label }}</a>{% endif %}<a class="btn" href="{{ s.order_url }}"{{ ext(s.order_url) }}>{{ header.order_button }}{{ extmark(s.order_url) }}</a></div>
</div></header>

<main id="main">
<section class="hero" aria-labelledby="hero-h">
<div class="w hero-top">
<a class="today today-m" href="#visit" data-label="{{ header.topbar_today_label }}"></a>
<h1 id="hero-h">{% if hero.eyebrow %}<span class="eyebrow">{{ hero.eyebrow }}</span>{% endif %}{{ hero.headline }}{% if hero.headline_italic %}<br/><i>{{ hero.headline_italic }}</i>{% endif %}</h1>
<div class="hero-side"><p>{{ hero.intro }}</p>
<div class="btns">{% if hero.primary_label %}<a class="btn" href="{{ hero.primary_url }}"{{ ext(hero.primary_url) }}>{{ hero.primary_label }}{{ extmark(hero.primary_url) }}</a>{% endif %}{% if hero.secondary_label %}<a class="btn o" href="{{ hero.secondary_url }}"{{ ext(hero.secondary_url) }}>{{ hero.secondary_label }}{{ extmark(hero.secondary_url) }}</a>{% endif %}</div></div>
</div>
{% if patio.enabled %}
<div class="scene" id="patio">{% include "patio-svg.njk" %}
<div class="ps-card" aria-live="polite"><span id="ps-k">{{ patio.card_live }} · {{ patio.card_place }}</span><b id="ps-m">{{ patio.card_checking }}</b><span id="ps-s"></span></div></div>
<div class="w scene-ctl">
<p class="cap">{{ patio.intro }}</p>
<label class="sl"><span>{{ patio.slider_label }}</span><input id="ps-r" type="range" min="0" max="1439" step="1"/></label>
<div class="chips" id="ps-ch" role="group" aria-label="{{ patio.sky_label }}"><button class="chip" data-ov="" aria-pressed="true">{{ patio.chip_live }}</button><button class="chip" data-ov="clear" aria-pressed="false">{{ patio.chip_clear }}</button><button class="chip" data-ov="cloud" aria-pressed="false">{{ patio.chip_cloudy }}</button><button class="chip" data-ov="rain" aria-pressed="false">{{ patio.chip_rain }}</button><button class="chip now" id="ps-now" hidden>{{ patio.back_to_now }}</button></div>
</div>
{% endif %}
</section>

{% if kitchen.enabled %}
<section class="story w" id="kitchen" aria-labelledby="kitchen-h">
<figure class="story-pic">{% img kitchen.image, kitchen.image_alt, "(max-width: 820px) 100vw, 40vw", "", "lazy" %}{% if kitchen.image_caption %}<figcaption>{{ kitchen.image_caption }}</figcaption>{% endif %}</figure>
<div class="story-txt">
<h2 id="kitchen-h">{{ heading(kitchen) }}{{ ink(0) }}</h2>
<p class="lede">{{ kitchen.body }}</p>
{% if kitchen.body_more %}{% for para in kitchen.body_more.split("\n\n") %}{% if para | trim %}<p class="story-more">{{ para | mdi | safe }}</p>{% endif %}{% endfor %}{% endif %}
{% if kitchen.story_label %}<p><a class="tl" href="{{ kitchen.story_url }}">{{ kitchen.story_label }}</a></p>{% endif %}
<ul class="spec">{% for c in kitchen.cards %}<li>{% if c.icon %}<svg class="ico" viewBox="0 0 88 88" aria-hidden="true" focusable="false"><use href="#ico-{{ c.icon }}"/></svg>{% else %}{% img c.image, c.alt or c.title, "96px", "", "lazy" %}{% endif %}<div><h3>{{ c.title }}</h3><p>{{ c.text }}</p></div></li>{% endfor %}</ul>
{% if kitchen.award_show %}<p class="award"><span>{{ kitchen.award_title }}</span> {{ kitchen.award_subtitle }}{% if kitchen.award_link_label %}. <a href="{{ kitchen.award_link_url }}">{{ kitchen.award_link_label }}</a>{% endif %}</p>{% endif %}
</div>
</section>
{% endif %}

{% if kitchen.enabled and kitchen.pair_show %}
<section class="w pairw" aria-labelledby="pair-h"><div class="pair">
<div class="pair-l"><h3 id="pair-h">{{ kitchen.pair_heading }}{{ ink(2) }}</h3><p>{{ kitchen.pair_helper }}</p>
<div class="pair-c"><label class="fld"><span>{{ kitchen.pair_food_label }}</span><select id="s1"><option value="">{{ kitchen.pair_food_placeholder }}</option>{% for m in kitchen.food_moods %}<option>{{ m.mood }}</option>{% endfor %}</select></label>
<label class="fld"><span>{{ kitchen.pair_drink_label }}</span><select id="s2"><option value="">{{ kitchen.pair_drink_placeholder }}</option>{% for m in kitchen.drink_moods %}<option>{{ m.mood }}</option>{% endfor %}</select></label>
<button class="btn" id="spin" type="button">{{ kitchen.pair_button }}</button></div></div>
<div class="pair-r" id="res" aria-live="polite" data-and="{{ kitchen.pair_and }}" data-food="{{ kitchen.pair_food_label }}" data-drink="{{ kitchen.pair_drink_label }}"><p class="pair-start">{{ kitchen.pair_start }}</p></div>
</div></section>
{% endif %}

{% if menu.enabled %}
<section class="menu w" id="menu" aria-labelledby="menu-h">
<div class="card">
<div class="card-hd"><h2 id="menu-h">{{ heading(menu) }}{{ ink(1) }}</h2>
<div class="ctl"><div role="tablist" class="tabs"><button aria-selected="true" class="tab" data-t="food" role="tab">{{ menu.food_tab }}</button><button aria-selected="false" class="tab" data-t="drinks" role="tab">{{ menu.drinks_tab }}</button></div>
<button aria-pressed="false" id="mf">{{ menu.meat_free_label }}</button><input aria-label="{{ menu.search_placeholder }}" id="q" placeholder="{{ menu.search_placeholder }}" type="search"/></div></div>
{% if menu.favorites_show and menu.favorites and menu.favorites.length %}<div class="favs"><h3 class="favs-h">{{ menu.favorites_heading }}</h3><ul>{% for f in menu.favorites %}{% set mi = menu | menuItem(f.item) %}<li><a href="#{{ f.item | slug }}" data-tab="{{ mi.tab }}" data-item="{{ f.item | slug }}">{% img f.image, f.alt or f.item, "(max-width: 900px) 45vw, 240px", "", "lazy" %}<span class="fn">{{ f.item }}</span><span class="fp">{{ mi.price }}</span></a></li>{% endfor %}</ul></div>{% endif %}
<nav class="jump" id="jump" aria-label="Menu categories"></nav>
<div class="cols" id="mn">{% for tab in [menu.food, menu.drinks] %}{% for c in tab %}<div class="g"><h3>{{ c.category }}</h3><ul>{% for i in c.items %}<li class="it"><div class="row"><span class="n">{{ i.name }}</span><span class="dots" aria-hidden="true"></span><span class="p">{% if i.price %}${{ i.price | fixed2 }}{% endif %}</span></div>{% if i.description %}<p class="d">{{ i.description }}</p>{% endif %}</li>{% endfor %}</ul></div>{% endfor %}{% endfor %}</div>
<p class="fine"><span aria-hidden="true">★</span> {{ menu.footnote }}</p>
</div>
</section>
{% endif %}

{% if reviews.enabled %}
<section class="reviews dark" id="reviews" aria-labelledby="reviews-h">
<div class="w">
<div class="rv-hd"><h2 id="reviews-h">{{ heading(reviews) }}{{ ink(2) }}</h2>
<p class="score"><b>{{ reviews.rating }}</b><span>{% for l in reviews.rating_sources | nl2br %}{{ l }}{% if not loop.last %}<br/>{% endif %}{% endfor %}</span></p></div>
{% set q0 = reviews.quotes[0] %}
{% if q0 %}<blockquote class="feat"><p>{{ q0.text }}</p><cite>{{ q0.source }}</cite></blockquote>{% endif %}
<div class="qs">{% for q in reviews.quotes %}{% if not loop.first %}<blockquote><p>{{ q.text }}</p><cite>{{ q.source }}</cite></blockquote>{% endif %}{% endfor %}</div>
{% if reviews.notes %}{% for para in reviews.notes.split("\n\n") %}{% if para | trim %}<p class="fine">{{ para | mdi | safe }}</p>{% endif %}{% endfor %}{% endif %}
<div class="rv-ft">
{% if reviews.mentions and reviews.mentions.length %}<p><span class="lbl">{{ reviews.mentions_label }}</span> {{ reviews.mentions | join(", ") }}</p>{% endif %}
{% if reviews.good_to_know %}<p>{{ reviews.good_to_know | mdi | safe }}</p>{% endif %}
<p><a href="https://www.google.com/maps/search/?api=1&amp;query={{ (s.business_name + ' ' + s.street + ' ' + s.city + ' ' + s.state + ' ' + s.zip) | enc }}">{{ reviews.google_link_label }}</a> <a href="{{ s.yelp_url }}">{{ reviews.yelp_link_label }}</a></p>
</div>
</div>
</section>
{% endif %}

{% if gallery.enabled %}
<section class="gallery w" id="gallery" aria-labelledby="gallery-h">
<div class="g-hd"><h2 id="gallery-h">{{ heading(gallery) }}{{ ink(0) }}</h2><p>{{ gallery.intro }}</p></div>
<div class="gal">{% for p in gallery.photos %}<figure class="{{ 'gw' if p.wide else 'gn' }}">{% img p.image, p.caption, ("(max-width: 820px) 100vw, 66vw" if p.wide else "(max-width: 820px) 50vw, 33vw"), "", "lazy" %}<figcaption>{{ p.caption }}</figcaption></figure>{% endfor %}</div>
<p class="g-ft">{% if gallery.instagram_lead %}<span>{{ gallery.instagram_lead }}</span>{% endif %}<a class="btn o" href="{{ s.instagram_url }}"{{ ext(s.instagram_url) }}>{{ gallery.follow_label }}{{ extmark(s.instagram_url) }}</a></p>
</section>
{% endif %}



{% if faq.enabled %}
<section class="faq w" id="faq" aria-labelledby="faq-h">
<div class="faq-h"><h2 id="faq-h">{{ heading(faq) }}{{ ink(1) }}</h2>{% if faq.note_text %}<p class="faq-note">{{ faq.note_text }} <a href="tel:{{ s.phone_dial }}">{{ s.phone_display }}</a>{% if faq.note_after %} {{ faq.note_after }}{% endif %}</p>{% endif %}{% if faq.show_drawing %}<div class="faq-art" aria-hidden="true"><svg class="ico" viewBox="0 0 88 88" focusable="false"><use href="#ico-croissant"/></svg><svg class="ico" viewBox="0 0 88 88" focusable="false"><use href="#ico-cup"/></svg><svg class="ico" viewBox="0 0 88 88" focusable="false"><use href="#ico-pine"/></svg></div>{% endif %}</div>
<div class="faq-l">{% for f in faq.items %}<details><summary>{{ f.question }}</summary><div class="ans">{% if f.answer %}{% for para in f.answer.split("\n\n") %}<p>{{ para | mdi | safe }}</p>{% endfor %}{% endif %}{% if f.show_hours %}<p>{% for g in hours.days | hoursGroups %}{{ g.days }}: {{ g.time }}<br/>{% endfor %}{{ hours.note }}</p>{% endif %}</div></details>
{% endfor %}</div>
</section>
{% endif %}
</main>

<footer class="ft dark" id="visit" aria-labelledby="visit-h">
<div class="w">
<div class="ft-cta"><h2 id="visit-h">{{ visit.cta_heading }}{{ ink(2) }}</h2><p>{{ visit.cta_text }}</p>
<div class="btns">{% for b in visit.cta_buttons %}{% set u = gDir if b.link == 'directions' else (s.order_url if b.link == 'order' else b.link) %}<a class="btn{% if b.outline %} o{% endif %}" href="{{ u }}"{{ ext(u) }}>{{ b.label }}{{ extmark(u) }}</a>{% endfor %}</div></div>
<div class="ft-g">
<div><h3>{{ visit.address_label }}</h3><p>{{ s.street }}<br/>{{ s.city }}, {{ s.state }} {{ s.zip }}</p><p class="sm"><button class="cp" id="cp">{{ visit.copy_label }}</button> <a href="https://maps.apple.com/?daddr={{ fullAddr | enc }}">Apple Maps</a> <a href="https://waze.com/ul?ll={{ (s.latitude + ',' + s.longitude) | enc }}&amp;navigate=yes">Waze</a></p></div>
<div><h3>{{ visit.hours_label }}</h3><p>{% for g in hours.days | hoursGroups %}<span class="hr-d">{{ g.days }}</span>{{ g.time }}{% endfor %}</p><p class="sm">{{ hours.note }}{% if hours.note_link_label %} <a href="{{ s.instagram_hours_url }}">{{ hours.note_link_label }}</a>{% endif %}</p></div>
<div><h3>{{ visit.phone_label }}</h3><p><a href="tel:{{ s.phone_dial }}">{{ s.phone_display }}</a></p><h3>{{ visit.instagram_label }}</h3><p><a href="{{ s.instagram_url }}">@{{ s.instagram_handle }}</a></p></div>
<a class="map" href="{{ gDir }}" aria-label="{{ visit.map_label }}. Opens Google Maps directions">{% include "map-svg.njk" %}</a>
</div>
<div class="ft-b"><img class="ft-logo" alt="{{ s.business_name }} logo" src="{{ s.logo_light or s.logo }}" width="900" height="216" loading="lazy"/>{% if footer.credit_label %}<a class="credit" href="{{ footer.credit_url }}" target="_blank" rel="noopener">{{ footer.credit_label }}</a>{% endif %}</div>
</div>
</footer>
<nav class="bar" aria-label="Quick actions"><a class="btn" href="{{ s.order_url }}"{{ ext(s.order_url) }}>{{ header.mobile_bar_order }}{{ extmark(s.order_url) }}</a><a class="btn o" href="tel:{{ s.phone_dial }}">{{ header.mobile_bar_call }}</a><a class="btn o" href="{{ gDir }}"{{ ext(gDir) }}>{{ header.mobile_bar_directions }}{{ extmark(gDir) }}</a></nav>
<script>const SITE={{ {
  hours: hours.days | hoursJS, verdicts: patio.verdicts,
  lat: s.latitude, lng: s.longitude, address: fullAddr, copied: visit.copied_label,
  patio: { card_live: patio.card_live, card_preview: patio.card_preview, card_place: patio.card_place },
  menu: { food: menu.food, drinks: menu.drinks, empty: menu.no_results },
  bite: kitchen.food_moods, sip: kitchen.drink_moods
} | json | safe }};</script>
<script>{% raw_include "menu.js" %}</script>
<script>{% raw_include "fx.js" %}</script>
{% if patio.enabled %}<script>{% raw_include "patio.js" %}</script>{% endif %}
</body></html>

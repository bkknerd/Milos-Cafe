{#- Shared template helpers. Import with: {% from "macros.njk" import ext, extmark, ink, heading with context %} -#}
{%- macro ext(url) -%}{% if url and (url == settings.order_url or url.startsWith('http')) %} target="_blank" rel="noopener"{% endif %}{%- endmacro -%}
{%- macro extmark(url) -%}{% if url and (url == settings.order_url or url.startsWith('http')) %}<svg class="ext" viewBox="0 0 12 12" aria-hidden="true"><path d="M4 2h6v6M10 2L3 9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="sr">{% if url == settings.order_url %} (opens {{ settings.order_provider or "online ordering" }} in a new tab){% else %} (opens in a new tab){% endif %}</span>{% endif %}{%- endmacro -%}
{%- macro ink(v) -%}{% set p = ["M4 12C62 6 128 15 196 9S276 9 296 5|M18 15C86 11 160 17 226 12S278 11 288 9","M3 9C70 15 140 6 210 11S270 13 297 8|M22 13C92 17 168 9 232 13S280 14 290 12","M5 13C58 8 120 11 180 8S262 6 296 10|M16 16C80 12 150 15 212 11S272 10 288 13"][v % 3].split("|") %}<svg class="ink" viewBox="0 0 300 20" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path pathLength="1" d="{{ p[0] }}"/><path class="ink2" pathLength="1" d="{{ p[1] }}"/></svg>{%- endmacro -%}
{%- macro heading(d) -%}{{ d.heading }}{% if d.heading_italic %} <i>{{ d.heading_italic }}</i>{% endif %}{%- endmacro -%}

---
permalink: /coming-soon/index.html
---
{%- set s = settings -%}
{%- set c = comingsoon -%}
{%- set fullAddr = s.street + ", " + s.city + ", " + s.state + " " + s.zip -%}
{%- set siteUrl = s.site_url or build.url -%}
{%- set gDir = "https://www.google.com/maps/dir/?api=1&destination=" + ((s.business_name + " " + fullAddr) | enc) -%}
{%- set extsvg = '<svg class="ext" viewBox="0 0 12 12" aria-hidden="true"><path d="M4 2h6v6M10 2L3 9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>' -%}
<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"/>
{% include "gtm-head.njk" %}
<script>document.documentElement.classList.add("js")</script>
<meta content="width=device-width, initial-scale=1, viewport-fit=cover" name="viewport"/>
<title>{{ c.page_title }}</title>
<meta name="description" content="{{ c.page_description }}"/>
<meta name="theme-color" content="#f8f7f3"/>
{% if siteUrl %}<link rel="canonical" href="{{ siteUrl }}/"/>{% endif %}
<link rel="preload" href="/fonts/fraunces-normal.woff2" as="font" type="font/woff2" crossorigin/>
<link rel="preload" href="/fonts/instrument-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin/>
<link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
<link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
<meta property="og:type" content="website"/>
<meta property="og:site_name" content="{{ s.business_name }}"/>
<meta property="og:title" content="{{ c.page_title }}"/>
<meta property="og:description" content="{{ c.page_description }}"/>
<meta property="og:image" content="{{ siteUrl if s.share_image.startsWith('/') }}{{ s.share_image }}"/>
<meta name="twitter:card" content="summary_large_image"/>
<script type="application/ld+json">{{ {
  "@context": "https://schema.org", "@type": "CafeOrCoffeeShop", "name": s.business_name,
  "url": siteUrl, "image": (siteUrl if s.share_image.startsWith('/')) + s.share_image,
  "telephone": s.phone_dial, "servesCuisine": s.cuisine,
  "address": { "@type": "PostalAddress", "streetAddress": s.street, "addressLocality": s.city, "addressRegion": s.state, "postalCode": s.zip, "addressCountry": "US" },
  "geo": { "@type": "GeoCoordinates", "latitude": s.latitude, "longitude": s.longitude },
  "areaServed": s.area_served | areaServed(s.state),
  "openingHoursSpecification": hours.days | hoursSchema,
  "sameAs": [s.instagram_url, s.yelp_url]
} | json | safe }}</script>
<style>{% raw_include "fonts.css" %}{% raw_include "styles.css" %}{% raw_include "coming-soon.css" %}</style>
</head><body class="cs">
{% include "gtm-body.njk" %}
<header class="cs-hd w"><img class="cs-logo" alt="{{ s.business_name }}" src="{{ s.logo }}" width="900" height="216"/><a class="today cs-today" href="#visit" data-label="{{ c.today_label }}"></a></header>

<main id="main">
<section class="cs-top w" aria-labelledby="cs-h">
<p class="cs-kicker">{{ c.kicker }}</p>
<h1 id="cs-h">{{ c.headline }}<br/><i>{{ c.headline_italic }}</i><svg class="ink" viewBox="0 0 300 20" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path pathLength="1" d="M4 12C62 6 128 15 196 9S276 9 296 5"/><path class="ink2" pathLength="1" d="M18 15C86 11 160 17 226 12S278 11 288 9"/></svg></h1>
<div class="cs-side"><p>{{ c.intro }}</p>
<div class="btns"><a class="btn" href="{{ s.order_url }}" target="_blank" rel="noopener">{{ c.order_label }}{{ extsvg | safe }}<span class="sr"> (opens {{ s.order_provider or "online ordering" }} in a new tab)</span></a><a class="btn o" href="tel:{{ s.phone_dial }}">{{ c.call_label }}</a><a class="btn o" href="{{ gDir }}" target="_blank" rel="noopener">{{ c.directions_label }}{{ extsvg | safe }}<span class="sr"> (opens in a new tab)</span></a></div></div>
</section>

<div class="scene" id="patio">{% include "patio-svg.njk" %}
<div class="ps-card" aria-live="polite"><span id="ps-k">{{ patio.card_live }} · {{ patio.card_place }}</span><b id="ps-m">{{ patio.card_checking }}</b><span id="ps-s"></span></div></div>
<div class="w scene-ctl">
<p class="cap">{{ c.scene_caption }}</p>
<label class="sl"><span>{{ patio.slider_label }}</span><input id="ps-r" type="range" min="0" max="1439" step="1"/></label>
<div class="chips" id="ps-ch" role="group" aria-label="{{ patio.sky_label }}"><button class="chip" data-ov="" aria-pressed="true">{{ patio.chip_live }}</button><button class="chip" data-ov="clear" aria-pressed="false">{{ patio.chip_clear }}</button><button class="chip" data-ov="cloud" aria-pressed="false">{{ patio.chip_cloudy }}</button><button class="chip" data-ov="rain" aria-pressed="false">{{ patio.chip_rain }}</button><button class="chip now" id="ps-now" hidden>{{ patio.back_to_now }}</button></div>
</div>
</main>

<footer class="ft dark cs-ft" id="visit" aria-label="Visit {{ s.business_name }}">
<div class="w">
<div class="cs-g">
<div><h2>{{ c.address_label }}</h2><p>{{ s.street }}<br/>{{ s.city }}, {{ s.state }} {{ s.zip }}</p></div>
<div><h2>{{ c.hours_label }}</h2><p>{% for g in hours.days | hoursGroups %}<span class="hr-d">{{ g.days }}</span>{{ g.time }}{% endfor %}</p>{% if hours.note %}<p class="sm">{{ hours.note }}</p>{% endif %}</div>
<div><h2>{{ c.contact_label }}</h2><p><a href="tel:{{ s.phone_dial }}">{{ s.phone_display }}</a><br/><a href="{{ s.instagram_url }}" target="_blank" rel="noopener">@{{ s.instagram_handle }}</a></p></div>
</div>
<div class="ft-b"><img class="ft-logo" alt="{{ s.business_name }} logo" src="{{ s.logo_light or s.logo }}" width="900" height="216" loading="lazy"/>{% if footer.credit_label %}<a class="credit" href="{{ footer.credit_url }}">{{ footer.credit_label }}</a>{% endif %}</div>
</div>
</footer>

<script>const SITE={{ {
  hours: hours.days | hoursJS, lat: s.latitude, lng: s.longitude,
  patio: { card_live: patio.card_live, card_preview: patio.card_preview, card_place: patio.card_place }
} | json | safe }};</script>
<script>{% raw_include "fx.js" %}</script>
<script>{% raw_include "patio.js" %}</script>
</body></html>
